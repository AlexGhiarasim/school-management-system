# MySQL container
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=school_management
MYSQL_USER=school
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

# Docker Compose (docker compose up --build)
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Backend
DATABASE_URL=mysql://school:change_me@localhost:3306/school_management
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_random_string_of_32_chars_or_more
JWT_EXPIRES_IN=730d
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Public sign-up of student accounts (POST /api/auth/register and the "Create
# account" tab). Off by default: accounts come from the seed script and from
# administrators. Set to true to let anyone create a student account.
ALLOW_PUBLIC_REGISTRATION=false

# Email for password resets. Optional: without these lines the messages go to
# Mailpit (http://localhost:8025) and nothing is sent to a real inbox.
# To use a real SMTP server, uncomment and fill in:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=School Management System <no-reply@example.com>
# The address used in the reset link.
# APP_URL=http://localhost:5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
