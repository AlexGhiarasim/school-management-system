# MySQL container
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=school_management
MYSQL_USER=school
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

# Docker Compose (docker compose up --build)
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Backend
DATABASE_URL=mysql://school:change_me@localhost:3306/school_management
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_random_string_of_32_chars_or_more
JWT_EXPIRES_IN=730d
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Email (password reset). Mailpit catches the messages in development.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=School Management System <no-reply@school.test>
APP_URL=http://localhost:5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
